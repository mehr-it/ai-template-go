# Local env overrides (secrets, dev-only settings)
.env
.env.testing
.env.local
.env.local.testing
dev-container/.env

# Per-worktree state (worktree dirs are conventionally at .worktrees/)
.worktrees/

# AI session stores (opencode SQLite DB, claude project histories, transcripts).
# Bind-mounted into the container at /home/ubuntu/.local/share/opencode and
# /home/ubuntu/.claude. Can grow to multi-GB — never commit.
/.ai-sessions/

# SQLite DBs from tests
*.db
*-shm
*-wal

# OpenCode config (user-specific, should not be version-controlled in template)
opencode.jsonc

# Go build outputs (post-bootstrap — uncomment after scaffolding)
# /bin/
# /dist/
# *.test
# *.out
# coverage.*
