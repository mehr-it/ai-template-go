# Docker environment configuration for the outer dev container.
#
# Bootstrap copies this file to dev-container/.env after step 8's sed sweep
# rewrites the __project_prefix__ placeholder below. If you clone the template
# without running bootstrap, or delete dev-container/.env manually, copy this
# file yourself: `cp dev-container/.env.example dev-container/.env`.
#
# dev-container/.env is gitignored. Edit UID/GID locally if the host user is
# not uid/gid 1000.

# Name of the dev container. Bootstrap rewrites __project_prefix__ to the
# project's lowercase alphanumeric slug (see bootstrap/AGENTS.md step 2).
#
# WARNING: container_name in dev-container/docker-compose.yml reserves this
# name globally on the Docker daemon. Two projects that pick the same
# PROJECT_NAME collide with "container name already in use". Keep it unique
# per repo; if two clones of the same bootstrapped project must coexist on
# one host, suffix one of them (e.g. PROJECT_NAME=acmebilling-secondary).
PROJECT_NAME=__project_prefix__

# Host user ID for file ownership inside container
UID=1000

# Host group ID for file ownership inside container
GID=1000
