# Generated by docker_inner/up.sh — DO NOT COMMIT.
# Ports are dynamic and change every time the stack restarts.

# signal-cli JSON-RPC daemon.
# POST calls to the RPC endpoint; read the inbound stream (SSE) from the events endpoint.
WASI_SIGNAL_RPC_URL=http://127.0.0.1:__SIGNAL_HTTP_PORT__/api/v1/rpc
WASI_SIGNAL_EVENTS_URL=http://127.0.0.1:__SIGNAL_HTTP_PORT__/api/v1/events

# The daemon starts with NO account linked, so account-scoped RPC calls will fail
# until you link one. `listAccounts` and `version` work unprovisioned and are the
# right smoke tests for the JSON-RPC client. See docker_inner/AGENTS.md to link.

# Postgres, for exercising the whatsmeow session store against a real server.
# Unused if the bridge stays on the pure-Go SQLite driver.
WASI_POSTGRES_DSN=postgres://wasi:wasi@127.0.0.1:__POSTGRES_PORT__/wasi_test?sslmode=disable

# whatsmeow session store. SQLite needs no service — the file is per-worktree,
# so parallel stacks are already isolated. Swap to WASI_POSTGRES_DSN to test Postgres.
WASI_WHATSAPP_STORE_DIALECT=sqlite
WASI_WHATSAPP_STORE_ADDRESS=file:.wasi-test-whatsmeow.db?_foreign_keys=on
